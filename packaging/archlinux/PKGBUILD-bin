# Maintainer: Antidote1911
pkgname=bombicat-bin
pkgver=1.0.1
pkgrel=1
pkgdesc="A minesweeper with cats, written in Rust with egui (pre-compiled binary)"
arch=('x86_64')
url="https://github.com/Antidote1911/bombicat"
license=('GPL-3.0-only')
depends=('libxcb' 'libxkbcommon' 'wayland' 'libgl')
provides=('bombicat')
conflicts=('bombicat' 'bombicat-git' 'bombicat-appimage')
source=("bombicat-${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/bombicat-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "bombicat-${pkgver}-linux-x86_64"

    install -Dm755 bombicat \
        "${pkgdir}/usr/bin/bombicat"

    install -Dm644 cat.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/bombicat.svg"

    cat > "${srcdir}/bombicat.desktop" << 'EOF'
[Desktop Entry]
Name=Bombicat
Comment=A minesweeper with cats
Exec=bombicat
Icon=bombicat
Type=Application
Categories=Game;LogicGame;BoardGame;
EOF
    install -Dm644 "${srcdir}/bombicat.desktop" \
        "${pkgdir}/usr/share/applications/bombicat.desktop"

    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
